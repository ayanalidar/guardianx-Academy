// GuardianX LMS — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("STUDENT") // STUDENT | INSTRUCTOR | ADMIN | SCHOOL_ADMIN
  avatar        String?
  bio           String?
  title         String? // e.g. "Senior Security Engineer"
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  lastActiveDate String? // YYYY-MM-DD for streak tracking
  schoolId      String? // linked school (for school-admin / school students)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments     Enrollment[]
  progress        LessonProgress[]
  notes           Note[]
  quizAttempts    QuizAttempt[]
  taughtCourses   Course[]
  labProgress     LabProgress[]
  certificates    Certificate[]
  liveSessionsHost LiveSession[] @relation("hostedSessions")
  liveSessionMembers LiveSessionMember[]
  discussions     Discussion[]
  replies         DiscussionReply[]
  achievements    UserAchievement[]
  activities      UserActivity[]
  notifications   Notification[]
  reviews         CourseReview[]
  bookmarks       Bookmark[]
  // New relations
  assignmentsCreated   Assignment[]
  submissions          AssignmentSubmission[]
  rubricsCreated       GradingRubric[]
  officeHourSlots      OfficeHourSlot[]
  officeHourBookings   OfficeHourBooking[]
  messageThreadsA      MessageThread[] @relation("threadUserA")
  messageThreadsB      MessageThread[] @relation("threadUserB")
  messages             Message[]
  studyGroupsCreated   StudyGroup[]
  studyGroupMemberships StudyGroupMember[]
  peerReviewsGiven     PeerReview[]
  peerReviewsReceived  PeerReview[] @relation("reviewedSubmissions")
  attendanceRecords    AttendanceRecord[]
  emailsReceived       EmailLog[]
  schoolMemberships    SchoolMember[]
  batchMemberships     BatchMember[]
  // Feature expansion relations
  aiChatSessions       AIChatSession[]
  codeReviews          CodeReview[]
  careerPaths          CareerPath[]
  postedJobs           Job[]
  jobApplications      JobApplication[]
  mockInterviews       MockInterview[]
  resumes              Resume[]
  ctfOrganized         CTFCompetition[]
  ctfTeamMemberships   CTFTeamMember[]
  weeklyChallengeSubs  WeeklyChallengeSubmission[]
  teamMissionMemberships TeamMissionMember[]
  learningAnalytics    LearningAnalytics[]
  skillAssessmentResults SkillAssessmentResult[]
  labSnapshots         LabSnapshot[]
  cyberRangeMemberships CyberRangeMember[]
  bugBountySubmissions  BugBountySubmission[]
  parentAccounts       ParentAccount[]
  authoredCourses      AuthoredCourse[]
}

// ============================================================
// School / Institution model — multi-tenant schools, colleges, universities
// ============================================================
model School {
  id            String   @id @default(cuid())
  schoolCode    String   @unique // e.g. "GXS-DELHI-001" — used for institution login
  name          String
  type          String   @default("SCHOOL") // SCHOOL | COLLEGE | UNIVERSITY
  email         String?  // contact email
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String   @default("India")
  logoUrl       String?
  website       String?
  // School admin credentials (the person who logs in via the School Portal tab)
  adminName     String
  adminEmail    String   @unique
  passwordHash  String
  status        String   @default("active") // active | suspended | pending
  maxStudents   Int      @default(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       SchoolMember[]
  batches       Batch[]
}

model SchoolMember {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String   @default("STUDENT") // STUDENT | INSTRUCTOR | SCHOOL_ADMIN
  joinedAt      DateTime @default(now())

  @@unique([schoolId, userId])
}

model Batch {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String   // e.g. "Batch 2024-A"
  courseIds     String   @default("") // comma-separated course IDs assigned to this batch
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("active") // active | completed | archived
  createdAt     DateTime @default(now())

  members       BatchMember[]
}

model BatchMember {
  id            String   @id @default(cuid())
  batchId       String
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt    DateTime @default(now())

  @@unique([batchId, userId])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. FIRST_LAB, STREAK_7
  title       String
  description String
  icon        String   @default("award") // lucide icon name
  color       String   @default("emerald")
  xp          Int      @default(50)
  tier        String   @default("bronze") // bronze | silver | gold | platinum
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime @default(now())

  @@unique([userId, achievementId])
}

model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // lesson_completed | lab_solved | quiz_passed | note_created | course_enrolled | cert_earned
  xp          Int      @default(0)
  meta        String   @default("") // JSON-ish metadata
  date        String   // YYYY-MM-DD (for daily aggregation / streaks)
  createdAt   DateTime @default(now())
}

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  shortName     String // e.g. "CEH"
  description   String
  longDescription String
  category      String // Certification / Networking / Cloud Security / etc.
  level         String // Beginner | Intermediate | Advanced
  durationHours Int      @default(40)
  price         Float    @default(0)
  rating        Float    @default(4.5)
  studentsCount Int      @default(0)
  thumbnail     String?
  color         String   @default("emerald") // theme accent
  tags          String   @default("") // comma separated
  certBody      String? // e.g. "EC-Council"
  published     Boolean  @default(true)
  prerequisiteIds String @default("") // comma-separated course IDs (Course Prerequisites feature)
  certificateTemplateId String? // optional template override
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  instructorId  String
  instructor    User     @relation(fields: [instructorId], references: [id])

  modules       Module[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  discussions   Discussion[]
  labs          Lab[]
  liveSessions  LiveSession[]
  reviews       CourseReview[]
  bookmarks     Bookmark[]
  // New relations
  assignments   Assignment[]
  rubrics       GradingRubric[]
  attendanceRecords AttendanceRecord[]
  studyGroups   StudyGroup[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  lessons     Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  type        String   @default("reading") // reading | pdf | video | lab
  content     String   @default("") // markdown / html text content
  pdfUrl      String?
  pdfPages    Int      @default(0)
  durationMin Int      @default(15)
  order       Int      @default(0)
  preview     Boolean  @default(false) // free preview

  progress    LessonProgress[]
  notes       Note[]
  quiz        Quiz?
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    Float    @default(0) // percentage 0-100
  completed   Boolean  @default(false)
  enrolledAt  DateTime @default(now())
  lastAccessed DateTime?

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  position    Int      @default(0) // pdf page or video position
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId    String?
  title       String   @default("Untitled note")
  content     String   @default("")
  color       String   @default("default")
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quiz {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String?
  questions   Question[]
  attempts    QuizAttempt[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text        String
  options     String   @default("") // pipe separated options
  answerIndex Int      @default(0)
  explanation String?
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int      @default(0) // percentage
  answers     String   @default("[]") // JSON
  passed      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateId String @unique
  issuedAt    DateTime @default(now())
  score       Int      @default(0)
  templateId  String?
  template    CertificateTemplate? @relation("certificateTemplate", fields: [templateId], references: [id])
  verificationHash String? // tamper-evident hash for verification
}

model Lab {
  id            String   @id @default(cuid())
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  title         String
  slug          String   @unique
  description   String
  longDescription String
  category      String // Web Security | Network | Privilege Escalation | Cryptography | Forensics | Reverse Engineering
  difficulty    String   @default("Easy") // Easy | Medium | Hard | Insane
  durationMin   Int      @default(30)
  points        Int      @default(100)
  tags          String   @default("")
  scenario      String   @default("") // markdown scenario/instructions
  objectives    String   @default("") // pipe separated objectives
  hints         String   @default("") // pipe separated hints
  flag          String   @default("FLAG{}") // CTF flag
  commands      String   @default("") // pipe separated available commands
  virtualEnv    String   @default("linux") // simulated env type
  color         String   @default("emerald")
  published     Boolean  @default(true)
  autoGrade     Boolean  @default(true) // auto-grade submission when flag matches
  xpReward      Int      @default(100) // XP awarded on completion
  passingScore  Int      @default(100) // minimum score to pass (auto-graded labs)
  createdAt     DateTime @default(now())

  progress      LabProgress[]
}

model LabProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  status      String   @default("not_started") // not_started | in_progress | completed
  flagFound   Boolean  @default(false)
  hintsUsed    Int      @default(0)
  timeSpentMs Int      @default(0) // cumulative time spent in the lab terminal (ms)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([userId, labId])
}

model LiveSession {
  id          String   @id @default(cuid())
  title       String
  description String?
  hostId      String
  host        User     @relation("hostedSessions", fields: [hostId], references: [id])
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  roomId      String   @unique // socket.io room
  status      String   @default("scheduled") // scheduled | live | ended
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  maxStudents Int      @default(50)
  createdAt   DateTime @default(now())

  members     LiveSessionMember[]
}

model LiveSessionMember {
  id          String   @id @default(cuid())
  sessionId   String
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("viewer") // host | cohost | viewer
  canShare    Boolean  @default(false)
  joinedAt    DateTime @default(now())

  @@unique([sessionId, userId])
}

model Discussion {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  replies     DiscussionReply[]
}

model DiscussionReply {
  id          String   @id @default(cuid())
  discussionId String
  discussion  Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // achievement | level_up | course_update | live_start | reply | streak | welcome | certificate
  title       String
  message     String
  icon        String   @default("bell") // lucide icon name
  color       String   @default("emerald")
  link        String?  // optional view target, JSON-encoded e.g. {"name":"achievements"}
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model CourseReview {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int      // 1-5 stars
  title       String   @default("")
  content     String   @default("")
  createdAt   DateTime @default(now())

  @@unique([userId, courseId])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, courseId])
}

// ============================================================
// NEW MODELS — GuardianX Academy feature expansion
// ============================================================

// --- Assignment System + Grading Rubric + Peer Review ---
model Assignment {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId      String?  // optional module link
  title         String
  description   String   @default("")
  instructions  String   @default("") // markdown
  pointsPossible Int     @default(100)
  dueDate       DateTime
  allowLate     Boolean  @default(true)
  latePenalty   Int      @default(10) // percent per day
  submissionType String  @default("text") // text | file | url
  enablePeerReview Boolean @default(false)
  peerReviewCount Int    @default(2) // how many peers review each submission
  peerReviewDueDate DateTime?
  rubricId      String?
  rubric        GradingRubric? @relation("assignmentRubric", fields: [rubricId], references: [id])
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions   AssignmentSubmission[]
  instructorId  String
  instructor    User     @relation(fields: [instructorId], references: [id])
}

model AssignmentSubmission {
  id            String   @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String   @default("") // text submission
  fileUrl       String?  // file or URL submission
  submittedAt   DateTime @default(now())
  late          Boolean  @default(false)
  grade         Int?     // final grade 0-100
  gradedAt      DateTime?
  gradedBy      String?
  feedback      String   @default("") // instructor feedback
  rubricScores  String   @default("[]") // JSON array of per-criterion scores
  status        String   @default("submitted") // submitted | graded | returned | resubmitted

  peerReviews   PeerReview[]

  @@unique([assignmentId, userId])
}

model GradingRubric {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  createdBy     String
  creator       User     @relation(fields: [createdBy], references: [id])
  criteria      RubricCriterion[]
  assignments   Assignment[] @relation("assignmentRubric")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RubricCriterion {
  id            String   @id @default(cuid())
  rubricId      String
  rubric        GradingRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  label         String   // e.g. "Technical Accuracy"
  description   String   @default("")
  points        Int      @default(25) // max points for this criterion
  order         Int      @default(0)
}

model PeerReview {
  id            String   @id @default(cuid())
  submissionId  String
  submission    AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUserId String
  reviewedUser  User     @relation("reviewedSubmissions", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  rating        Int      @default(0) // 1-5
  feedback      String   @default("")
  rubricScores  String   @default("[]") // JSON
  submittedAt   DateTime @default(now())

  @@unique([submissionId, reviewerId])
}

// --- Office Hours Scheduler ---
model OfficeHourSlot {
  id            String   @id @default(cuid())
  instructorId  String
  instructor    User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  courseId      String?  // optional course-specific
  startAt       DateTime
  endAt         DateTime
  mode          String   @default("video") // video | in-person | chat
  location      String   @default("") // meeting link or room
  maxBookings   Int      @default(1)
  bookings      OfficeHourBooking[]
  createdAt     DateTime @default(now())
}

model OfficeHourBooking {
  id            String   @id @default(cuid())
  slotId        String
  slot          OfficeHourSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic         String   @default("")
  notes         String   @default("")
  status        String   @default("booked") // booked | completed | cancelled
  createdAt     DateTime @default(now())

  @@unique([slotId, studentId])
}

// --- Student Messaging ---
model MessageThread {
  id            String   @id @default(cuid())
  userAId       String
  userA         User     @relation("threadUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String
  userB         User     @relation("threadUserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
}

model Message {
  id            String   @id @default(cuid())
  threadId      String
  thread        MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// --- Study Groups ---
model StudyGroup {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  courseId      String?  // optional course link
  course        Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  creatorId     String
  creator       User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  maxMembers    Int      @default(10)
  isPrivate     Boolean  @default(false)
  joinCode      String?  // required if private
  meetingLink   String?  // optional video/chat link
  tags          String   @default("")
  createdAt     DateTime @default(now())
  members       StudyGroupMember[]
}

model StudyGroupMember {
  id            String   @id @default(cuid())
  groupId       String
  group         StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String   @default("member") // owner | member
  joinedAt      DateTime @default(now())

  @@unique([groupId, userId])
}

// --- Attendance Tracking ---
model AttendanceRecord {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String   // YYYY-MM-DD
  sessionType   String   @default("live") // live | in-person | exam
  status        String   @default("present") // present | absent | late | excused
  notes         String   @default("")
  recordedAt    DateTime @default(now())

  @@unique([courseId, userId, date, sessionType])
}

// --- Certificate Templates ---
model CertificateTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String   @default("")
  // Visual config (JSON-encoded)
  primaryColor  String   @default("#10b981") // emerald
  accentColor   String   @default("#06b6d4") // cyan
  fontFamily    String   @default("serif")
  borderStyle   String   @default("classic") // classic | modern | minimal | holographic
  logoUrl       String?
  signatureText String   @default("Director, GuardianX Academy")
  sealStyle     String   @default("emerald") // emerald | gold | cyan | holographic
  backgroundPattern String @default("grid") // grid | particles | none | circuit
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  certificates  Certificate[] @relation("certificateTemplate")
}

// --- Email Notifications (log + stub) ---
model EmailLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail       String
  subject       String
  body          String
  type          String   @default("notification") // notification | certificate | assignment | reminder | welcome
  status        String   @default("sent") // sent | failed | queued
  sentAt        DateTime @default(now())
}

// ============================================================
// FEATURE EXPANSION — 20 new feature models
// ============================================================

// --- 1. AI Learning Assistant ---
model AIChatSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  labId       String?
  context     String   @default("") // current page context
  messages    AIChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  session     AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String   // user | assistant
  content     String
  createdAt   DateTime @default(now())
}

// --- 2. Live Threat Intelligence Feed ---
model ThreatFeed {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String   @default("medium") // low | medium | high | critical
  category    String   // malware | vulnerability | breach | attack | advisory
  source      String   @default("GuardianX Intelligence")
  cve         String?
  ioc         String?  // indicator of compromise
  affectedSystems String @default("")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// --- 3. AI Code Review ---
model CodeReview {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  labId       String?
  language    String   @default("python") // python | bash | javascript | c | sql
  code        String
  feedback    String   @default("") // AI-generated feedback (JSON)
  score       Int      @default(0) // 0-100
  issues      String   @default("[]") // JSON array of issues found
  createdAt   DateTime @default(now())
}

// --- 4. Career Path Planner ---
model CareerPath {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole  String   // SOC Analyst | Pentester | Security Engineer | CISO | etc.
  currentRole String   @default("")
  targetSalary String  @default("")
  recommendedCourses String @default("[]") // JSON array of course IDs
  recommendedCerts String @default("[]") // JSON array of cert names
  recommendedLabs String @default("[]") // JSON array of lab IDs
  estimatedWeeks Int   @default(12)
  progress    Int      @default(0) // 0-100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CareerRole {
  id          String   @id @default(cuid())
  title       String   @unique
  description String
  avgSalary   String
  requiredSkills String @default("[]") // JSON array
  recommendedCourses String @default("[]") // JSON array of course IDs
  growthRate  String   @default("15%")
  category    String   @default("security") // security | network | cloud | governance
}

// --- 5. Job Board ---
model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  companyLogo String?
  location    String
  remote      Boolean  @default(false)
  type        String   @default("full-time") // full-time | part-time | contract | internship
  salary      String   @default("")
  description String
  requirements String  @default("")
  requiredCerts String @default("[]") // JSON array
  requiredSkills String @default("[]") // JSON array
  postedById  String
  postedBy    User     @relation(fields: [postedById], references: [id])
  status      String   @default("active") // active | closed | draft
  applications JobApplication[]
  createdAt   DateTime @default(now())
}

model JobApplication {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverLetter String   @default("")
  status      String   @default("pending") // pending | reviewed | shortlisted | rejected | hired
  createdAt   DateTime @default(now())

  @@unique([jobId, userId])
}

// --- 6. Mock Interview ---
model MockInterview {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   // SOC Analyst | Pentester | etc.
  difficulty  String   @default("intermediate") // beginner | intermediate | advanced
  questions   String   @default("[]") // JSON array of questions
  answers     String   @default("[]") // JSON array of answers
  score       Int      @default(0)
  feedback    String   @default("")
  duration    Int      @default(0) // seconds
  completedAt DateTime?
  createdAt   DateTime @default(now())
}

model InterviewQuestion {
  id          String   @id @default(cuid())
  role        String   // SOC Analyst | Pentester | etc.
  difficulty  String   @default("intermediate")
  question    String
  expectedAnswer String @default("")
  category    String   @default("technical") // technical | behavioral | scenario
  tags        String   @default("")
}

// --- 7. Resume Builder ---
model Resume {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template    String   @default("professional") // professional | modern | minimal | cybersecurity
  summary     String   @default("")
  experience  String   @default("[]") // JSON array
  education   String   @default("[]") // JSON array
  skills      String   @default("[]") // JSON array
  certifications String @default("[]") // JSON array (auto-populated from GuardianX)
  projects    String   @default("[]") // JSON array
  contactInfo String   @default("{}") // JSON
  isPublic    Boolean  @default(false)
  shareUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- 8. CTF Competition ---
model CTFCompetition {
  id          String   @id @default(cuid())
  title       String
  description String
  format      String   @default("jeopardy") // jeopardy | attack-defense
  startAt     DateTime
  endAt       DateTime
  maxTeams    Int      @default(50)
  teamSize    Int      @default(4)
  status      String   @default("upcoming") // upcoming | live | ended
  prizes      String   @default("")
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id])
  challenges  CTFChallenge[]
  teams       CTFTeam[]
  createdAt   DateTime @default(now())
}

model CTFChallenge {
  id            String   @id @default(cuid())
  competitionId String
  competition   CTFCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  title         String
  description   String
  category      String   // web | crypto | forensics | reverse | pwn | misc
  difficulty    String   @default("easy") // easy | medium | hard | insane
  points        Int      @default(100)
  flag          String
  hint          String?
  hintsUsed     Int      @default(0)
  solveCount    Int      @default(0)
  order         Int      @default(0)
  submissions   CTFSubmission[]
}

model CTFTeam {
  id            String   @id @default(cuid())
  competitionId String
  competition   CTFCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  captainId     String
  members       CTFTeamMember[]
  score         Int      @default(0)
  rank          Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([competitionId, name])
}

model CTFTeamMember {
  id          String   @id @default(cuid())
  teamId      String
  team        CTFTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("member") // captain | member
  joinedAt    DateTime @default(now())

  @@unique([teamId, userId])
}

model CTFSubmission {
  id            String   @id @default(cuid())
  challengeId   String
  challenge     CTFChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  teamId        String
  flag          String
  correct       Boolean  @default(false)
  submittedAt   DateTime @default(now())
}

// --- 9. Weekly Challenges ---
model WeeklyChallenge {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // web | crypto | forensics | network | misc
  difficulty  String   @default("medium")
  flag        String
  points      Int      @default(500)
  hint        String?
  startAt     DateTime @default(now())
  endAt       DateTime
  isActive    Boolean  @default(true)
  participants WeeklyChallengeSubmission[]
  createdAt   DateTime @default(now())
}

model WeeklyChallengeSubmission {
  id          String   @id @default(cuid())
  challengeId String
  challenge   WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flag        String
  correct     Boolean  @default(false)
  timeTaken   Int      @default(0) // seconds
  submittedAt DateTime @default(now())

  @@unique([challengeId, userId])
}

// --- 10. Team Lab Missions ---
model TeamMission {
  id          String   @id @default(cuid())
  title       String
  description String
  scenario    String
  maxTeamSize Int      @default(4)
  duration    Int      @default(60) // minutes
  difficulty  String   @default("medium")
  objectives  String   @default("[]") // JSON array
  status      String   @default("active")
  sessions    TeamMissionSession[]
  createdAt   DateTime @default(now())
}

model TeamMissionSession {
  id          String   @id @default(cuid())
  missionId   String
  mission     TeamMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  leaderId    String
  status      String   @default("waiting") // waiting | active | completed | failed
  members     TeamMissionMember[]
  startedAt   DateTime?
  completedAt DateTime?
  score       Int      @default(0)
  createdAt   DateTime @default(now())
}

model TeamMissionMember {
  id          String   @id @default(cuid())
  sessionId   String
  session     TeamMissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("member") // leader | scanner | exploiter | reporter
  joinedAt    DateTime @default(now())

  @@unique([sessionId, userId])
}

// --- 11. Learning Analytics ---
model LearningAnalytics {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTimeSpent Int   @default(0) // seconds
  coursesStarted Int   @default(0)
  coursesCompleted Int @default(0)
  labsAttempted Int    @default(0)
  labsSolved  Int      @default(0)
  avgQuizScore Float   @default(0)
  currentStreak Int    @default(0)
  longestStreak Int    @default(0)
  skillRadar  String   @default("{}") // JSON: { web: 75, network: 60, ... }
  weeklyActivity String @default("[]") // JSON: array of {date, minutes}
  peerComparison String @default("{}") // JSON: percentile data
  updatedAt   DateTime @updatedAt
}

// --- 12. Skill Assessment ---
model SkillAssessment {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // web | network | crypto | forensics | reverse | governance
  difficulty  String   @default("intermediate")
  duration    Int      @default(30) // minutes
  questions   SkillAssessmentQuestion[]
  results     SkillAssessmentResult[]
  createdAt   DateTime @default(now())
}

model SkillAssessmentQuestion {
  id            String   @id @default(cuid())
  assessmentId  String
  assessment    SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question      String
  options       String   @default("[]") // JSON array
  correctAnswer Int      @default(0)
  explanation   String   @default("")
  skillTag      String   @default("") // e.g., "sql-injection"
  points        Int      @default(10)
}

model SkillAssessmentResult {
  id            String   @id @default(cuid())
  assessmentId  String
  assessment    SkillAssessment @relation(fields: [assessmentId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       String   @default("[]") // JSON
  score         Int      @default(0)
  passed        Boolean  @default(false)
  skillScores   String   @default("{}") // JSON: per-skill breakdown
  takenAt       DateTime @default(now())
}

