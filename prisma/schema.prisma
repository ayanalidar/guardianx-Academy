// Update User model with new relations
// Note: These are added at the end to avoid circular reference issues

// --- 22. CMS (Content Management System) ---
// SiteContent stores editable copy for every public-facing page so admins
// can change text/copy/arrays/objects without redeploying. Pages read the
// public GET /api/cms/[page] endpoint to render.
model SiteContent {
  id        String   @id @default(cuid())
  page      String   // e.g. "home", "impact", "contact", "institutions", "catalog", "course-detail", "auth", "global"
  section   String   // e.g. "hero", "stats", "audiences", "courses", "labs", "corporate", "partners", "benefits", "finalCta", "header", "footer", "trust"
  key       String   // e.g. "title", "subtitle", "description", "ctaPrimary", "stats", "items", "body"
  value     Json     // can be string | string[] | {title, desc, icon}[] | object
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([page, section, key])
  @@index([page, section])
}

// ============================================================
// PRODUCTION MODELS — database-driven content (Phase PROD-DB)
// ============================================================

/// Learning paths — guided career journeys (replaces hardcoded arrays)
model LearningPath {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  description String
  icon        String   @default("Route") // Lucide icon name
  color       String   @default("text-violet-300")
  tint        String   @default("bg-violet-500/10")
  difficulty  String   @default("Beginner") // Beginner | Intermediate | Advanced
  duration    String   @default("12 weeks")
  skillsCount Int      @default(0)
  labsCount   Int      @default(0)
  xpReward    Int      @default(5000)
  careerOutcome String?
  skills      String   @default("[]") // JSON array of skill names
  courses     String   @default("[]") // JSON array of course IDs
  order       Int      @default(0)
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Skill categories — branches of the skill tree
model SkillCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  icon        String   @default("Shield")
  color       String   @default("text-violet-300")
  tint        String   @default("bg-violet-500/10")
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skills      Skill[]
}

/// Individual skills — nodes in the skill tree
model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  categoryId  String
  category    SkillCategory @relation(fields: [categoryId], references: [id])
  difficulty  String   @default("Beginner")
  xp          Int      @default(100)
  status      String   @default("available") // locked | available | in-progress | completed
  prerequisites String @default("[]") // JSON array of skill slugs
  relatedCourses String @default("[]") // JSON array of course IDs
  relatedLabs String   @default("[]") // JSON array of lab IDs
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Rank hierarchy — 8 tiers from Recruit to Elite Guardian
model Rank {
  id          String   @id @default(cuid())
  name        String   @unique // RECRUIT, ANALYST, HUNTER, OPERATOR, SPECIALIST, SENTINEL, GUARDIAN, ELITE_GUARDIAN
  displayName String   // "Recruit", "Analyst", etc.
  level       Int      @unique // 1-8
  xpThreshold Int      // XP needed to reach this rank
  color       String   @default("text-gray-400")
  description String?
  icon        String   @default("Shield")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Career roles — for career matching engine
/// (renamed from CareerRole → CareerPathRole to avoid collision with the
///  pre-existing CareerRole model used by /api/career/roles)
model CareerPathRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  icon        String   @default("Briefcase")
  color       String   @default("text-violet-300")
  // Skill weights as JSON: {"networking": 20, "linux": 20, "web": 25, "pentesting": 30, "reporting": 5}
  skillWeights String  @default("{}")
  minThreshold Int     @default(60) // minimum readiness % to be "ready"
  recommendedCerts String @default("[]") // JSON array of cert names
  recommendedCourses String @default("[]") // JSON array of course IDs
  recommendedLabs String @default("[]") // JSON array of lab IDs
  salaryRange String?
  demand      String   @default("High") // High | Medium | Low
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Platform statistics — admin-managed, optionally auto-calculated
model PlatformStat {
  id          String   @id @default(cuid())
  key         String   @unique // "learner_count", "lab_count", "course_count", "partner_count"
  label       String   // "Learners", "Labs", "Courses", "Partners"
  value       String   // "12000+" or calculated value
  source      String   @default("manual") // "manual" | "calculated"
  displayStatus String @default("visible") // visible | hidden
  suffix      String?  // "+", "", etc.
  icon        String   @default("Users")
  color       String   @default("text-violet-300")
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

/// Technology ecosystem — replaces fake "Trusted by Google" logos
model TechnologyPartner {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   @default("tool") // tool | platform | framework
  description String?
  url         String?
  icon        String   @default("Terminal")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// EXAM PLATFORM — Proctored examinations and GuardianX certs
// ============================================================

/// GuardianX certification — distinct from external certifications
model GuardianCertification {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  level       String   @default("Intermediate") // Beginner | Intermediate | Advanced | Expert
  domains     String   @default("[]") // JSON array of domain names
  skills      String   @default("[]") // JSON array of skills assessed
  examId      String?  // linked exam
  passingScore Int     @default(70)
  validityPeriod Int   @default(36) // months
  icon        String   @default("Award")
  color       String   @default("text-violet-300")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  credentials GuardianCredential[]
}

/// Exam blueprint — configurable exam template
model Exam {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?
  certificationId String? // linked GuardianCertification
  duration      Int      @default(120) // minutes
  passingScore  Int      @default(70)
  maxAttempts   Int      @default(3)
  questionCount Int      @default(50)
  sections      String   @default("[]") // JSON: [{title, questionCount, domains}]
  questionType  String   @default("mcq") // mcq | multiple | truefalse | scenario | practical | hybrid
  proctoringEnabled Boolean @default(true)
  shuffleQuestions Boolean @default(true)
  shuffleOptions  Boolean @default(true)
  status        String   @default("draft") // draft | published | archived
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attempts      ExamAttempt[]
  questions     QuestionBank[]
}

/// Question bank — tagged by domain, skill, difficulty
model QuestionBank {
  id            String   @id @default(cuid())
  examId        String?
  exam          Exam?    @relation(fields: [examId], references: [id])
  type          String   @default("mcq") // mcq | multiple | truefalse | scenario | practical
  domain        String   // e.g. "Web Security", "Network Security", "GRC", "DFIR"
  skill         String?
  difficulty    String   @default("medium") // easy | medium | hard
  question      String
  options       String   @default("[]") // JSON array of option strings
  correctAnswer String   // JSON: index for mcq, array for multiple, "true"/"false" for boolean
  explanation   String?
  points        Int      @default(1)
  tags          String   @default("[]") // JSON array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Exam attempt — a learner's attempt at an exam
model ExamAttempt {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  userId        String
  status        String   @default("scheduled") // scheduled | in-progress | submitted | graded | passed | failed | voided
  startedAt     DateTime?
  submittedAt   DateTime?
  score         Int?     // percentage
  totalQuestions Int?
  correctAnswers Int?
  answers       String   @default("[]") // JSON: [{questionId, selected, correct}]
  proctorFlags  String   @default("[]") // JSON: [{type, timestamp, detail}]
  timeSpent     Int?     // seconds
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// GuardianX credential — issued when a learner passes an exam
model GuardianCredential {
  id              String   @id @default(cuid())
  credentialId    String   @unique // GX-CERT-YYYY-XXXX format
  userId          String
  certificationId String
  certification   GuardianCertification @relation(fields: [certificationId], references: [id])
  examAttemptId   String?
  candidateName   String
  score           Int
  skillsAssessed  String   @default("[]") // JSON array
  examType        String   @default("proctored")
  issueDate       DateTime @default(now())
  expiryDate      DateTime?
  status          String   @default("valid") // valid | expired | revoked | suspended
  verificationHash String  @unique
  verificationUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Proctoring session — records proctoring data for an exam attempt
model ProctoringSession {
  id            String   @id @default(cuid())
  examAttemptId String   @unique
  userId        String
  identityVerified Boolean @default(false)
  environmentChecked Boolean @default(false)
  cameraEnabled Boolean  @default(false)
  microphoneEnabled Boolean @default(false)
  screenShared  Boolean  @default(false)
  fullscreenMode Boolean @default(false)
  tabSwitches   Int      @default(0)
  windowBlurs   Int      @default(0)
  flags         String   @default("[]") // JSON: [{type, timestamp, severity, detail}]
  incidentCount Int      @default(0)
  recordingUrl  String?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  createdAt     DateTime @default(now())
}

// ============================================================
// ADMIN-UPGRADE — Instructor Profile + Lead CRM models
// ============================================================

model InstructorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String?
  expertise       String   @default("[]") // JSON: ["Offensive Security", "Defensive", ...]
  yearsExperience Int      @default(0)
  certifications  String   @default("[]") // JSON: ["CEH", "OSCP", ...]
  linkedinUrl     String?
  maxBatches      Int      @default(3)
  currentBatches  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  organization  String?
  type          String   @default("Individual") // Individual | School | College | University | Corporate | Partner | Workshop | CTF | Webinar
  status        String   @default("New") // New | Contacted | Qualified | Proposal | Negotiation | Converted | Lost
  source        String   @default("Contact Form") // Google Form | Contact Form | Manual | Referral
  score         Int      @default(0) // 0-100 lead score
  notes         LeadNote[]
  history       LeadStatusHistory[]
  followUpDate  DateTime?
  assignedTo    String? // staff member name/ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())
}

model LeadStatusHistory {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus  String
  changedAt DateTime @default(now())
}

// ============================================================
// TRAINING-BATCH-CRUD — public certification training batches
// (separate from the school-tied `Batch` model).
// ============================================================
model TrainingBatch {
  id              String   @id @default(cuid())
  certification   String                       // e.g. "CompTIA Security+", "CEH", "CCNA", "CISSP"
  name            String                       // e.g. "Security+ Weekend Batch"
  schedule        String                       // human-readable schedule e.g. "Sat + Sun, 7:00 PM - 9:00 PM IST"
  startDate       String                       // e.g. "October 12" (display string)
  startIsoDate    String?                      // optional ISO date for sorting/filtering
  mode            String   @default("Live Online")  // "Live Online" | "On-Campus"
  instructor      String                       // instructor name
  instructorId    String?                      // optional link to User
  seats           Int      @default(20)        // total capacity
  enrolled        Int      @default(0)         // currently enrolled count
  level           String   @default("Beginner") // "Beginner" | "Intermediate" | "Advanced"
  status          String   @default("Open")    // "Open" | "Almost Full" | "Full" | "Completed" | "Cancelled"
  certColor       String   @default("text-emerald-300")
  certTint        String   @default("bg-emerald-500/15")
  certBorder      String   @default("border-emerald-500/30")
  levelColor      String   @default("text-emerald-300")
  levelTint       String   @default("bg-emerald-500/10")
  levelBorder     String   @default("border-emerald-500/30")
  borderColor     String   @default("border-border/60")
  btnClass        String   @default("bg-emerald-600 hover:bg-emerald-500")
  description     String   @default("")        // optional longer description
  featured        Boolean  @default(false)     // show on homepage
  order           Int      @default(0)         // sort order
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
