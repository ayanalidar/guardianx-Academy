// --- 15. Collaborative Cyber Range ---
model CyberRange {
  id          String   @id @default(cuid())
  name        String
  description String
  topology    String   @default("{}") // JSON: network topology config
  machines    String   @default("[]") // JSON: array of machine configs
  maxUsers    Int      @default(10)
  difficulty  String   @default("advanced")
  duration    Int      @default(120) // minutes
  status      String   @default("available")
  sessions    CyberRangeSession[]
  createdAt   DateTime @default(now())
}

model CyberRangeSession {
  id          String   @id @default(cuid())
  rangeId     String
  range       CyberRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  leaderId    String
  status      String   @default("waiting") // waiting | active | completed
  members     CyberRangeMember[]
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
}

model CyberRangeMember {
  id          String   @id @default(cuid())
  sessionId   String
  session     CyberRangeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("member") // leader | attacker | defender | observer
  joinedAt    DateTime @default(now())

  @@unique([sessionId, userId])
}

// --- 16. Bug Bounty Integration ---
model BugBountyProgram {
  id          String   @id @default(cuid())
  name        String
  platform    String   @default("GuardianX") // GuardianX | HackerOne | Bugcrowd
  url         String
  description String
  scope       String   @default("")
  rewardRange String   @default("$0 - $0")
  difficulty  String   @default("medium")
  tags        String   @default("")
  submissions BugBountySubmission[]
  createdAt   DateTime @default(now())
}

model BugBountySubmission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId   String
  program     BugBountyProgram @relation(fields: [programId], references: [id])
  title       String
  description String
  severity    String   @default("medium") // low | medium | high | critical
  status      String   @default("submitted") // submitted | validated | rewarded | rejected
  bounty      String   @default("")
  createdAt   DateTime @default(now())
}

