// No DB models needed — PWA is a frontend manifest + service worker

// --- 19. Parent/Guardian Portal ---
model ParentAccount {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  passwordHash String
  phone       String?
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String  @default("parent") // parent | guardian
  createdAt   DateTime @default(now())
}

// --- 20. Course Authoring Studio ---
model AuthoredCourse {
  id          String   @id @default(cuid())
  title       String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status      String   @default("draft") // draft | review | published
  config      String   @default("{}") // JSON: full course config (modules, lessons, quizzes, labs)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Update User model with new relations
// Note: These are added at the end to avoid circular reference issues

// --- 22. CMS (Content Management System) ---
// SiteContent stores editable copy for every public-facing page so admins
// can change text/copy/arrays/objects without redeploying. Pages read the
// public GET /api/cms/[page] endpoint to render.
model SiteContent {
  id        String   @id @default(cuid())
  page      String   // e.g. "home", "impact", "contact", "institutions", "catalog", "course-detail", "auth", "global"
  section   String   // e.g. "hero", "stats", "audiences", "courses", "labs", "corporate", "partners", "benefits", "finalCta", "header", "footer", "trust"
  key       String   // e.g. "title", "subtitle", "description", "ctaPrimary", "stats", "items", "body"
  value     Json     // can be string | string[] | {title, desc, icon}[] | object
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([page, section, key])
  @@index([page, section])
}
